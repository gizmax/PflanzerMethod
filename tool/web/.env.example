# Pflanzer web hub — OIDC (SSO) mode. Copy to .env and fill in; never commit .env.
# See README-auth.md. Without .env, `docker compose up` runs in dev mode.

# Activates the oauth2-proxy service (same as `--profile oidc`)
COMPOSE_PROFILES=oidc
# Backend rejects requests without SSO identity (401)
PFLANZER_HUB_AUTH_MODE=oidc
# nginx config with auth_request → oauth2-proxy
PFLANZER_NGINX_CONF=pflanzer.oidc.conf

# Issuer URL of your IdP, e.g.
#   Entra ID:  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Okta:      https://<org>.okta.com/oauth2/default
#   Keycloak:  https://<host>/realms/<realm>
OAUTH2_PROXY_OIDC_ISSUER_URL=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32 random bytes, base64 URL-safe:
#   python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=
# Allowed e-mail domain(s), comma separated, e.g. example.com
OAUTH2_PROXY_EMAIL_DOMAINS=
# Must match the redirect URI registered in the IdP
OAUTH2_PROXY_REDIRECT_URL=https://pflanzer.cz/oauth2/callback

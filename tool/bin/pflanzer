#!/usr/bin/env bash
# Pflanzer CLI wrapper — proxies subcommands to tool/cli/<name>.py.
# Works from any directory (target repo), so slash commands never depend on cwd.
set -euo pipefail

if [ -n "${PFLANZER_PLUGIN_DIR:-}" ]; then
  ROOT="$PFLANZER_PLUGIN_DIR"
else
  SELF="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
  ROOT="$(cd "$(dirname "$SELF")/../.." && pwd)"
fi

if [ "$#" -eq 0 ]; then
  echo "Pflanzer Method | pflanzer.cz/method"
  echo ""
  echo "Nejčastější příkazy:"
  echo "  pflanzer status      # kde projekt stojí a co je další krok"
  echo "  pflanzer doctor      # je target repo připravené ke Kickoffu?"
  echo "  pflanzer checkpoint  # podpis okna (zadani | bezpecnost | pravo | provoz | design)"
  echo "  pflanzer build       # nápověda k Buildu (worktrees, prompty, preview)"
  echo "  pflanzer feedback    # feedback zástupců (Async)"
  echo "  pflanzer decide      # Rozhodnutí (go | iterate | kill)"
  echo "  pflanzer ship        # Ship: quality gates + PR"
  echo "  pflanzer hub         # web hub pro feedback"
  echo ""
  echo "Vše: pflanzer help"
  exit 0
fi
SUB="$1"
shift

case "$SUB" in
  root)
    echo "$ROOT" ;;
  db)
    PYTHONPATH="$ROOT" python3 -c 'from tool.cli.db import DB_PATH; print(DB_PATH)' ;;
  data)
    PYTHONPATH="$ROOT" python3 -c 'from tool.cli.db import DATA_ROOT; print(DATA_ROOT)' ;;
  update)
    git -C "$ROOT" pull --ff-only
    PYTHONPATH="$ROOT" python3 "$ROOT/tool/db/migrate.py"
    if command -v claude >/dev/null; then
      claude plugin marketplace update pflanzer-method || true
      claude plugin update pflanzer@pflanzer-method || true
    fi ;;
  ship)
    PYTHONPATH="$ROOT" exec python3 "$ROOT/tool/cli/session_3.py" "$@" ;;
  decide)
    PYTHONPATH="$ROOT" exec python3 "$ROOT/tool/cli/session_2.py" decide "$@" ;;
  vote)
    PYTHONPATH="$ROOT" exec python3 "$ROOT/tool/cli/quick_session.py" vote "$@" ;;
  prompts)
    PYTHONPATH="$ROOT" exec python3 "$ROOT/tool/cli/quick_session.py" prompts "$@" ;;
  build)
    # Varianty podle režimu projektu (parallel: A/B/C, mob: jedna společná `mob`); bez --slug obecně.
    BSLUG=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --slug) BSLUG="${2:-}"; shift 2 || shift ;;
        --slug=*) BSLUG="${1#--slug=}"; shift ;;
        *) shift ;;
      esac
    done
    VARIANTS="varianty projektu: A/B/C, u mob mode jedna \`mob\`"
    if [ -n "$BSLUG" ]; then
      MODE="$(PYTHONPATH="$ROOT" python3 -c 'import sys; from tool.cli.quick_session import project_session_mode; print(project_session_mode(sys.argv[1]))' "$BSLUG" 2>/dev/null || echo parallel)"
      if [ "$MODE" = "mob" ]; then VARIANTS="varianta \`mob\` (mob mode, jeden společný worktree)"; else VARIANTS="varianty A/B/C"; fi
    fi
    echo "**Pflanzer Method | pflanzer.cz/method**"
    echo ""
    echo "Build nemá jeden příkaz — vede ho /pm build (Claude Code). Kroky v terminálu:"
    echo "  pflanzer worktree setup --slug S     # worktrees: $VARIANTS (+ další repa projektu)"
    echo "  pflanzer prompts --slug S            # prompty pro buildery ($VARIANTS)"
    echo "  pflanzer preview up --slug S         # spustí varianty s heslem a odkazy"
    echo "  pflanzer vote --spec spec.json       # zápis Buildu (šablona: .pflanzer/specs/S-vote.json)"
    echo "Další krok vždy ukáže: pflanzer status" ;;
  help|-h|--help)
    echo "Pflanzer Method | pflanzer.cz/method"
    echo ""
    echo "Usage: pflanzer <příkaz> [args]"
    echo ""
    echo "Cesta projektem:"
    echo "  pflanzer status                # kde projekt stojí a co je další krok"
    echo "  pflanzer build                 # nápověda k Buildu (worktrees, prompty, preview, zápis)"
    echo "  pflanzer preview up --slug S   # spustí varianty (všechna repa) s heslem (+ tunel); down|status"
    echo "  pflanzer vote --spec spec.json # zápis Buildu (hlasování jádra)"
    echo "  pflanzer feedback              # feedback zástupců (Async)"
    echo "  pflanzer hub                   # web hub pro feedback (http://localhost:8000/method/)"
    echo "  pflanzer decide --slug S go --winner A --rationale …   # Rozhodnutí (alias session_2 decide)"
    echo "  pflanzer ship --slug S         # Ship: quality gates + PR (alias session_3)"
    echo "  pflanzer checkpoint --slug S zadani|bezpecnost|pravo|provoz|design --by JMÉNO --note …"
    echo "  pflanzer checkpoint --slug S bezpecnost --ai --note …   # AI draft (ADR-0023), podepíše člověk"
    echo "  pflanzer doctor                # je target repo připravené ke Kickoffu?"
    echo ""
    echo "Správa:"
    echo "  pflanzer root      # kořen metody (docs/, tool/)"
    echo "  pflanzer db        # cesta k SQLite DB"
    echo "  pflanzer data      # datová složka (DB, charters, feedback, ...)"
    echo "  pflanzer update    # git pull + migrace + update pluginu"
    echo ""
    echo "Všechny příkazy mají lidský výstup; --json dá strojový. --spec - čte JSON ze stdin."
    echo ""
    echo "Všechny moduly:"
    ls "$ROOT/tool/cli/"*.py | xargs -n1 basename | sed 's/\.py$//' | grep -v -e '^_' -e '^db$' | sed 's/^/  pflanzer /' ;;
  *)
    SCRIPT="$ROOT/tool/cli/${SUB}.py"
    if [ ! -f "$SCRIPT" ]; then
      CMDS="root db data update help ship decide vote prompts build $(ls "$ROOT/tool/cli/"*.py | xargs -n1 basename | sed 's/\.py$//' | grep -v -e '^_' -e '^db$' | tr '\n' ' ')"
      # shellcheck disable=SC2086
      NEAR="$(python3 -c 'import difflib,sys; m=difflib.get_close_matches(sys.argv[1], sys.argv[2:], n=1, cutoff=0.6); print(m[0] if m else "")' "$SUB" $CMDS)"
      echo "Pflanzer Method | pflanzer.cz/method" >&2
      echo "" >&2
      MSG="CHYBA: Neznámý příkaz ‚${SUB}‘."
      if [ -n "$NEAR" ]; then MSG="$MSG Myslel jste ‚${NEAR}‘?"; fi
      echo "$MSG" >&2
      echo "Přehled: pflanzer help" >&2
      exit 2
    fi
    PYTHONPATH="$ROOT" exec python3 "$SCRIPT" "$@" ;;
esac

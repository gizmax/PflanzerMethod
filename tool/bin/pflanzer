#!/usr/bin/env bash
# Pflanzer CLI wrapper — proxies subcommands to tool/cli/<name>.py.
# Works from any directory (target repo), so slash commands never depend on cwd.
set -euo pipefail

if [ -n "${PFLANZER_PLUGIN_DIR:-}" ]; then
  ROOT="$PFLANZER_PLUGIN_DIR"
else
  SELF="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
  ROOT="$(cd "$(dirname "$SELF")/../.." && pwd)"
fi

if [ "$#" -eq 0 ]; then
  echo "Pflanzer Method | pflanzer.cz/method"
  echo ""
  echo "Nejčastější příkazy:"
  echo "  pflanzer status      # kde projekt stojí a co je další krok"
  echo "  pflanzer doctor      # je target repo připravené ke Kickoffu?"
  echo "  pflanzer checkpoint  # podpis okna (bezpecnost | provoz | design)"
  echo "  pflanzer feedback    # feedback zástupců (Async)"
  echo "  pflanzer hub         # web hub pro feedback"
  echo ""
  echo "Vše: pflanzer help"
  exit 0
fi
SUB="$1"
shift

case "$SUB" in
  root)
    echo "$ROOT" ;;
  db)
    PYTHONPATH="$ROOT" python3 -c 'from tool.cli.db import DB_PATH; print(DB_PATH)' ;;
  data)
    PYTHONPATH="$ROOT" python3 -c 'from tool.cli.db import DATA_ROOT; print(DATA_ROOT)' ;;
  update)
    git -C "$ROOT" pull --ff-only
    PYTHONPATH="$ROOT" python3 "$ROOT/tool/db/migrate.py"
    if command -v claude >/dev/null; then
      claude plugin marketplace update pflanzer-method || true
      claude plugin update pflanzer@pflanzer-method || true
    fi ;;
  help|-h|--help)
    echo "Pflanzer Method | pflanzer.cz/method"
    echo ""
    echo "Usage: pflanzer <subcommand> [args]"
    echo "  pflanzer root      # kořen metody (docs/, tool/)"
    echo "  pflanzer db        # cesta k SQLite DB"
    echo "  pflanzer data      # datová složka (DB, charters, feedback, ...)"
    echo "  pflanzer update    # git pull + migrace + update pluginu"
    echo "  pflanzer hub       # web hub pro feedback (http://localhost:8000/method/)"
    echo "  pflanzer checkpoint --slug S bezpecnost|provoz --by JMÉNO --note …  # podpis okna"
    echo "  pflanzer checkpoint --slug S bezpecnost --ai --note …               # AI draft (ADR-0023), podepíše člověk"
    echo ""
    echo "Všechny příkazy mají lidský výstup; --json dá strojový. --spec - čte JSON ze stdin."
    ls "$ROOT/tool/cli/"*.py | xargs -n1 basename | sed 's/\.py$//' | grep -v -e '^_' -e '^db$' | sed 's/^/  pflanzer /' ;;
  *)
    SCRIPT="$ROOT/tool/cli/${SUB}.py"
    if [ ! -f "$SCRIPT" ]; then
      CMDS="root db data update help $(ls "$ROOT/tool/cli/"*.py | xargs -n1 basename | sed 's/\.py$//' | grep -v -e '^_' -e '^db$' | tr '\n' ' ')"
      # shellcheck disable=SC2086
      NEAR="$(python3 -c 'import difflib,sys; m=difflib.get_close_matches(sys.argv[1], sys.argv[2:], n=1, cutoff=0.6); print(m[0] if m else "")' "$SUB" $CMDS)"
      echo "Pflanzer Method | pflanzer.cz/method" >&2
      echo "" >&2
      MSG="CHYBA: Neznámý příkaz ‚${SUB}‘."
      if [ -n "$NEAR" ]; then MSG="$MSG Myslel jste ‚${NEAR}‘?"; fi
      echo "$MSG" >&2
      echo "Příkazy: $(echo $CMDS | sed 's/ /, /g')." >&2
      echo "Podrobnosti: pflanzer help" >&2
      exit 2
    fi
    PYTHONPATH="$ROOT" exec python3 "$SCRIPT" "$@" ;;
esac

# Pflanzer Method | pflanzer.cz/method
#
# pflanzer.gates.yml — quality gate adapter for `tool/cli/quality_gates.py`.
# Generated by `pflanzer init gates-template` on {{date}}.
# Detected stack: {{stack}}
#
# When this file exists (in the checked dir or any parent up to the git root),
# its commands REPLACE autodetection. A gate that is missing or commented out
# reports `unsupported` (excluded from the score), never `fail`.
#
# Per-gate keys:
#   cmd:         shell command (string; `&&`, env vars and wrappers are fine)
#   cwd:         working dir, relative to THIS file (default ".")
#   parse:       exit_code                      -> exit 0 = pass, otherwise fail
#                'regex:<pattern>'              -> needs a named group (?P<metric>...)
#                                                  searched in stdout+stderr
#   warn_below / fail_below: metric thresholds (coverage %, pass rate %)
#   warn_above / fail_above: metric thresholds for counts (lint issues, CVEs)
#   timeout:     seconds (default 600)
#   builtin:     true -> reuse the built-in runner (secret scan, TS a11y/console scan)
# A gate may also be a plain string: `build: "make build"`.
# Non-zero exit is always `fail`; exit 127 (command not found) is `unsupported`.
# Quote regexes with SINGLE quotes — YAML double quotes break on `\d`.
# Remember: the variant under review lives in the same repo, so review diffs
# of this file like any other CI config change.

# build — compiles / bundles the app; fail-fast gate (weight 1.5).
{{gate:build}}

# types — static type check. For compiled languages the build gate already
# covers it; leave it out unless you run an extra checker (weight 1.5).
{{gate:types}}

# lint — linter / formatter check, exit code 0 = clean (weight 1.0).
{{gate:lint}}

# tests — unit + integration tests, exit code 0 = all green (weight 2.0).
{{gate:tests}}

# coverage — branch/line coverage %, parsed from output via regex.
# Target 60 % (warn below), fail below 30 % (weight 1.0).
{{gate:coverage}}

# acceptance — Decider-written acceptance scenarios from tests/acceptance/
# (ADR-0010). Primary reuse signal (weight 2.5).
{{gate:acceptance}}

# security — secret scan + dependency audit. `builtin: true` keeps the
# built-in secret scan; replace with your SCA tool if you have one (weight 2.0).
{{gate:security}}

# a11y — accessibility check; only meaningful for UI code (weight 1.0).
{{gate:a11y}}

# observability — stray console/print logging instead of a structured
# logger (weight 0.5).
{{gate:observability}}
